    Firebase->>Google: OAuth popup
    Google-->>User: Chọn tài khoản
    Google-->>Firebase: OAuth credential
    Firebase-->>authApi: UserCredential (result)
    authApi->>Firebase: result.user.getIdToken()
    Firebase-->>authApi: idToken (JWT)

    authApi->>axiosClient: POST /auth/firebase-login<br/>Authorization: Bearer {idToken}
    axiosClient->>Router: HTTP POST
    Router->>Deps: Depends(get_current_user)
    Deps->>Deps: get_bearer_token() → extract token
    Deps->>AuthSvc: login_with_firebase_token(token)
    AuthSvc->>FBAdmin: verify_firebase_id_token(token)
    FBAdmin-->>AuthSvc: decoded_token {uid, email, name, picture}

    AuthSvc->>UserRepo: get_by_firebase_uid(uid)
    UserRepo->>DB: SELECT * FROM users WHERE firebase_uid = ?
    DB-->>UserRepo: User | None

    alt User không tồn tại
        AuthSvc->>UserRepo: create_firebase_user(...)
        UserRepo->>DB: INSERT INTO users (...)
    else User đã tồn tại
        AuthSvc->>UserRepo: update_firebase_profile(...)
        UserRepo->>DB: UPDATE users SET ...
    end

    AuthSvc->>DB: COMMIT
    AuthSvc-->>Deps: User object
    Deps-->>Router: User object
    Router-->>axiosClient: AuthUserResponse (JSON)
    axiosClient-->>authApi: response.data

    authApi->>authApi: localStorage.setItem("access_token", idToken)
    authApi->>authApi: localStorage.setItem("auth_user", JSON.stringify(user))
    authApi-->>LoginModal: user data
    LoginModal->>Sidebar: onLogin(user) → setCurrentUser(user)
    Sidebar->>Sidebar: Re-render: hiển thị avatar + tên
