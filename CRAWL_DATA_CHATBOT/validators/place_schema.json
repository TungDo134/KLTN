{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Place",
  "type": "object",
  "required": [
    "place_id",
    "name",
    "region",
    "category",
    "tags",
    "location",
    "duration_minutes",
    "rating"
  ],
  "properties": {
    "place_id": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "region": { "type": "string" },
    "province": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "thiên nhiên",
        "ẩm thực",
        "văn hóa",
        "giải trí",
        "mua sắm",
        "lưu trú"
      ]
    },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "description": { "type": "string" },
    "location": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "address": { "type": "string" }
      }
    },
    "duration_minutes": { "type": "integer", "minimum": 0 },
    "opening_hours": {
      "type": "object",
      "properties": {
        "weekday": { "type": "string" },
        "weekend": { "type": "string" },
        "closed_days": { "type": "array", "items": { "type": "string" } }
      }
    },
    "price": {
      "type": "object",
      "properties": {
        "adult": { "type": "number" },
        "child": { "type": "number" },
        "currency": { "type": "string" },
        "budget_level": {
          "type": "string",
          "enum": ["free", "low", "medium", "high"]
        }
      }
    },
    "rating": { "type": "number", "minimum": 0, "maximum": 5 },
    "review_count": { "type": "integer", "minimum": 0 },
    "popularity_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "best_time": { "type": "array", "items": { "type": "string" } },
    "suitable_for": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string" },
    "source_url": { "type": "string" },
    "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
